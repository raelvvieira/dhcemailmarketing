# Resend API (resend.com — substitui o SMTP)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Remetente (deve ser um email do domínio verificado no Resend)
EMAIL_FROM_NAME=Deni Haut
EMAIL_FROM_ADDRESS=contato@aceleradoradhc.com.br

# Segurança do webhook (coloque qualquer string forte, ex: dhc_secret_2024)
WEBHOOK_SECRET=dhc_secret_2024

# Token gerado pela Kiwify nas configurações do webhook (opcional, mas recomendado)
KIWIFY_TOKEN=cole_aqui_o_token_da_kiwify

# Porta do servidor (Railway define automaticamente)
PORT=3000
