# Hostinger SMTP (veja: https://support.hostinger.com/en/articles/1583967)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seu-email@seudominio.com
SMTP_PASS=sua-senha-de-email

# Remetente
EMAIL_FROM_NAME=Deni Haut
EMAIL_FROM_ADDRESS=seu-email@seudominio.com

# Segurança do webhook (coloque qualquer string forte, ex: dhc_secret_2024)
WEBHOOK_SECRET=dhc_secret_2024

# Porta do servidor (Railway define automaticamente)
PORT=3000
